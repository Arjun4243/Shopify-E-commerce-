{% liquid
  assign normalized_title = title | downcase | strip
  assign icon_file = ''
  assign description = ''

  case normalized_title
    when 'contact'
      assign icon_file = 'mega-menu-contact.webp'
      assign description = 'Get in touch with us'
    when 'blog'
      assign icon_file = 'mega-menu-blog.webp'
      assign description = 'Read our latest articles'
    when 'faq'
      assign icon_file = 'mega-menu-faq.webp'
      assign description = 'Find answers to common questions'
    when 'about'
      assign icon_file = 'mega-menu-about.webp'
      assign description = 'Learn more about us'
    when 'our boutiques', 'our branches'
      assign icon_file = 'mega-menu-boutiques.webp'
      assign description = 'Find our stores'
    when 'payment methods', 'payment method'
      assign icon_file = 'mega-menu-payment-methods.webp'
      assign description = 'We accept multiple payment options'
    when 'return & exchange', 'returns & exchanges', 'return and exchange'
      assign icon_file = 'mega-menu-return-exchange.webp'
      assign description = 'Easy returns & exchanges'
    when 'careers'
      assign icon_file = 'mega-menu-careers.webp'
      assign description = 'Join our growing team'
    when 'terms & condition', 'terms & conditions', 'terms and condition', 'terms and conditions'
      assign icon_file = 'mega-menu-terms-condition.webp'
      assign description = 'Read our terms & conditions'
    when 'privacy policy'
      assign icon_file = 'mega-menu-privacy-policy.webp'
      assign description = 'Your privacy is important to us'
    when 'ring', 'rings'
      assign icon_file = 'mega-menu-jewellery-ring.webp'
    when 'earring', 'earrings'
      assign icon_file = 'mega-menu-jewellery-earring.webp'
    when 'pendant', 'pendants', 'pandent', 'pandents'
      assign icon_file = 'mega-menu-jewellery-pendant.webp'
    when 'amethyst'
      assign icon_file = 'mega-menu-semi-precious-amethyst.webp'
    when 'ametrine'
      assign icon_file = 'mega-menu-semi-precious-ametrine.webp'
    when 'black agate'
      assign icon_file = 'mega-menu-semi-precious-black-agate.webp'
    when 'carnelian'
      assign icon_file = 'mega-menu-semi-precious-carnelian.webp'
    when 'citrine'
      assign icon_file = 'mega-menu-semi-precious-citrine.webp'
    when 'garnet'
      assign icon_file = 'mega-menu-semi-precious-garnet.webp'
    when 'green onex', 'green onyx'
      assign icon_file = 'mega-menu-semi-precious-green-onex.webp'
    when 'howlite'
      assign icon_file = 'mega-menu-semi-precious-howlite.webp'
    when 'labradorite'
      assign icon_file = 'mega-menu-semi-precious-labradorite.webp'
    when 'lapis lazuli'
      assign icon_file = 'mega-menu-semi-precious-lapis-lazuli.webp'
    when 'lemon topaz'
      assign icon_file = 'mega-menu-semi-precious-lemon-topaz.webp'
    when 'moonstone'
      assign icon_file = 'mega-menu-semi-precious-moonstone.webp'
    when 'peridot'
      assign icon_file = 'mega-menu-semi-precious-peridot.webp'
    when 'rose quartz'
      assign icon_file = 'mega-menu-semi-precious-rose-quartz.webp'
    when 'smoky quartz', 'smokey quartz'
      assign icon_file = 'mega-menu-semi-precious-smoky-quartz.webp'
    when 'topaz'
      assign icon_file = 'mega-menu-semi-precious-topaz.webp'
    when 'turquoise'
      assign icon_file = 'mega-menu-semi-precious-turquoise.webp'
  endcase
%}

{% if icon_file != blank %}
  <span class="mega-menu__link-icon" aria-hidden="true">
    <img
      src="{{ icon_file | asset_url }}"
      alt=""
      loading="lazy"
      width="42"
      height="42"
    >
  </span>
{% endif %}

<span class="mega-menu__link-copy">
  <span class="wrap-text mega-menu__link-label">{{- title -}}</span>
  {% if description != blank %}
    <span class="mega-menu__link-description">{{- description -}}</span>
  {% endif %}
</span>
